{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FoodGo (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=SUPABASE_URL=${input:supabaseUrl}",
        "--dart-define=SUPABASE_PUBLISHABLE_KEY=${input:supabasePublishableKey}"
      ]
    },
    {
      "name": "FoodGo (release)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=SUPABASE_URL=${input:supabaseUrl}",
        "--dart-define=SUPABASE_PUBLISHABLE_KEY=${input:supabasePublishableKey}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "supabaseUrl",
      "type": "promptString",
      "description": "Supabase Project URL"
    },
    {
      "id": "supabasePublishableKey",
      "type": "promptString",
      "description": "Supabase publishable (anon) key"
    }
  ]
}